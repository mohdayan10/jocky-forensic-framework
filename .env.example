# JOCKY Environment Configuration
# Copy to .env and fill in values before running docker compose up

# Anthropic API key — required for Step 16 AI explanation
ANTHROPIC_API_KEY=sk-ant-api03-...

# Database
DATABASE_URL=postgresql://jocky:jocky@postgres:5432/jocky

# Redis / Celery broker
REDIS_URL=redis://redis:6379/0

# Hyperledger Fabric
FABRIC_NETWORK_PROFILE=/fabric/network.json

# JOCKY CA private key (PEM) for signing investigator certificates
JOCKY_CA_KEY=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend
REACT_APP_API_URL=/api
